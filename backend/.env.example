# ==============================================================================
# Credit Portfolio Risk Engine - Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="Credit Portfolio Risk Engine"
ENVIRONMENT="development"
DEBUG=false
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
# For local dev without Postgres, the app automatically falls back to: sqlite:///./credit_risk.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credit_risk_db"

# Redis Cache Configuration
# For local dev without Redis, the app automatically falls back to an in-memory TTL cache
REDIS_URL="redis://localhost:6379/0"
CACHE_EXPIRATION_SECONDS=3600

# Apache Kafka Event Streaming Configuration
# When KAFKA_ENABLED=false, the app automatically operates using a local domain event bus
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_ENABLED=false
KAFKA_TOPIC_CREDIT_EVENTS="credit-events"
KAFKA_CONSUMER_GROUP_ID="credit-risk-consumer-group"

# Data Directory
DATA_DIR="../data"
