# Credit Portfolio Risk Engine - Environment Configuration
PROJECT_NAME="Credit Portfolio Risk Engine"
ENVIRONMENT="development"
DEBUG=false
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL with SQLite local dev fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credit_risk_db"

# Redis Cache Configuration (with in-memory local fallback)
REDIS_URL="redis://localhost:6379/0"
CACHE_EXPIRATION_SECONDS=3600

# Event Streaming: Kafka (with local domain event bus fallback)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_ENABLED=false
KAFKA_TOPIC_CREDIT_EVENTS="credit-events"
KAFKA_CONSUMER_GROUP_ID="credit-risk-consumer-group"

# Data Directory
DATA_DIR="data"
